# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

# Nix direnv
/.direnv

*.DS_Store

# Git worktrees
/.worktrees

# Superpowers brainstorming
/.superpowers
/docs/superpowers/

# Local debug scratch tests
/test/controllers/debug_*_test.rb

# Accidental duplicate migrate folders (e.g. Finder copy)
/db/migrate */

/ignored/

# SQLite databases and scratch copies must never be committed
/*.sqlite3
/*.sqlite3-*

# Local Kamal deployment config (copy from the .example files)
/config/deploy.yml
/.kamal/secrets
