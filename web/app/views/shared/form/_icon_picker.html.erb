

<fieldset>
    <legend class="utilities--sr-only">Icon</legend>
    <div role="radiogroup" aria-label="Icon picker">
      <% Iconable::ICON_MAPPINGS.each do |name| %>
      <label>
        <%= form.radio_button :icon, name, class: "utilities--sr-only" %>
        <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
        <%= icon(name) %>
        </div>
        <span class="utilities--sr-only"><%= name.humanize %></span>
      </label>
      <% end %>

    </div>
</fieldset>
