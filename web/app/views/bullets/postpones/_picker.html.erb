<%# locals: (bullet_ids: "", postpone_options: []) %>

<header>
  <h2 class="utilities--sr-only">Schedule</h2>
</header>

<main aria-label="Schedule"
      data-controller="postpone-picker"
      data-postpone-picker-today-value="<%= Date.current.iso8601 %>"
      data-action="keydown->postpone-picker#navigate">
  <%= form_with url: postpone_path, method: :post,
        class: "picker--form",
        data: { turbo_stream: true } do %>
    <%= hidden_field_tag :bullet_ids, bullet_ids, data: { bullet_menu_target: "idList" } %>
    <%= label_tag :postpone_query, "Choose a date", class: "utilities--sr-only" %>
    <%= search_field_tag :postpone_query, nil,
          placeholder: "Try Oct 2, Mon, or 14",
          autocomplete: "off", autofocus: !mobile_variant?,
          class: "picker--request",
          aria: { controls: "postpone_suggestions", describedby: "postpone_hint" },
          data: { postpone_picker_target: "textfield", action: "input->postpone-picker#search search->postpone-picker#search" } %>

    <ul class="combobox" role="list" aria-label="Quick dates" data-postpone-picker-target="defaults">
      <% postpone_options.each do |option| %>
        <li>
          <%= button_tag type: :submit, name: :pops_on, value: option[:pops_on].iso8601,
                class: "combobox--item" do %>
            <%= icon(option[:icon]) %>
            <p><%= option[:name] %> · <%= option[:pops_on].strftime("%a, %b %-d") %></p>
          <% end %>
        </li>
      <% end %>
    </ul>

    <ul id="postpone_suggestions" class="combobox" role="list" aria-label="Suggested dates"
        data-postpone-picker-target="results" aria-live="polite" hidden></ul>
    <p id="postpone_hint" class="picker--hint" data-postpone-picker-target="hint" role="status" hidden>
      Try a day (14), month (October), weekday (Mon), or date (Oct 2).
    </p>

    <template data-postpone-picker-target="template">
      <li>
        <button type="submit" name="pops_on" class="combobox--item">
          <%= icon("calendar") %>
          <p data-date-label></p>
        </button>
      </li>
    </template>
  <% end %>
</main>
