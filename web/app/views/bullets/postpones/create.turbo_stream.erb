<% if @failed_bullet %>
  <%= turbo_stream.update "toasts" do %>
    <% messages = @failed_bullet.respond_to?(:errors) && @failed_bullet.errors.any? ? @failed_bullet.errors.full_messages : ["Could not postpone"] %>
    <%= render "shared/toasts", type: "errmsg", messages: messages %>
  <% end %>
<% else %>
  <%= render "bullets/postpones/scheduled", bullets: @bullets %>
<% end %>
