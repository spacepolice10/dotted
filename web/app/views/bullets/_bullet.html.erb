<%# locals: (bullet:) %>
<turbo-frame
  id="<%= dom_id(bullet) %>"
  class="bullet"
  data-bullet-done="<%= bullet.completed? ? "true" : "false" %>"
>
  <input
    type="checkbox"
    id="<%= dom_id(bullet, :select_checkbox) %>"
    value="<%= bullet.id %>"
    data-bulk-done="<%= bullet.completed? %>"
    data-bulk-published="<%= bullet.published? %>"
    data-public-url="<%= published_url(bullet.public_code) if bullet.published? %>"
    data-note-url="<%= edit_bullet_note_path(bullet) %>"
    data-with-note="<%= bullet.with_note? %>"
    data-checklist-url="<%= bullet.with_checklist? ? edit_bullet_checklist_path(bullet) : new_bullet_checklist_path(bullet) %>"
    data-bullet-menu-target="checkbox"
    data-action="bullet-menu#toggle"
    class="utilities--sr-only"
  >

  <div class="bullet--content">
    <% if bullet.file.attached? %>
      <label
        class="bullet--select-checkbox"
        for="<%= dom_id(bullet, :select_checkbox) %>"
        aria-label="Select bullet"
      ></label>
    <% end %>
    <div class="bullet--body">
      <% unless bullet.file.attached? %>
        <label
          class="bullet--select-square"
          for="<%= dom_id(bullet, :select_checkbox) %>"
          aria-label="Select bullet"
        ></label>
      <% end %>
      <% if bullet.file.attached? %>
        <%= render "bullets/attachment", file: bullet.file, selection_id: dom_id(bullet, :select_checkbox) %>
      <% else %>
        <%= bullet.body %>
      <% end %>
      <%= render "bullets/metadata", bullet: bullet %>
    </div>
    <% if bullet.with_note? %>
      <%= render "notes/preview", note: bullet.note %>
    <% end %>
    <% if bullet.with_checklist? %>
      <%= render "checklists/checklist", bullet: bullet, checklist: bullet.checklist %>
    <% end %>
  </div>

</turbo-frame>
