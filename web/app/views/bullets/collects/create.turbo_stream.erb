<% if @failed_bullet&.errors&.any? %>
  <%= turbo_stream.update "toasts" do %>
    <%= render "shared/toasts", type: "errmsg", messages: @failed_bullet.errors.full_messages %>
  <% end %>
<% else %>
  <%= turbo_stream.update "toasts" do %>
    <% message = @bullets.size == 1 ? "Bullet collected into #{@collection.name}" : "#{@bullets.size} bullets collected into #{@collection.name}" %>
    <%= render "shared/toasts", type: "notify", messages: [message] %>
  <% end %>
  <%= turbo_stream.replace dom_id(@collection, :collect_row) do %>
    <%= render "bullets/collects/collection",
          collection: @collection,
          bullet_ids: @bullet_ids,
          collected_ids: @collected_collection_ids %>
  <% end %>
  <% @bullets.each do |bullet| %>
    <%= render "bullets/updated", bullet: bullet %>
    <% if (previous_collection_id = bullet.collection_id_before_last_save).present? && bullet.saved_change_to_collection_id? %>
      <%= turbo_stream.remove_all ".collection-board[data-collection-id=#{previous_collection_id}] #collection_item_#{dom_id(bullet)}" %>
    <% end %>
  <% end %>
  <%= turbo_stream.replace dom_id(@collection, :board) do %>
    <%= render "collections/board", collection: @collection,
          bullets: @collection.unsorted_bullets, parked_items: @collection.parked_items %>
  <% end %>
<% end %>
