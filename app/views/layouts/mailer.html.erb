<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title><%= content_for(:title) || "Dotted" %></title>
  </head>

  <body style="margin: 0; padding: 0; background-color: #f7f6f4; color: #3d3d44; font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 14px; line-height: 1.5; -webkit-font-smoothing: antialiased;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f7f6f4;">
      <tr>
        <td align="center" style="padding: 32px 24px 0;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 608px; background-color: #fff; border: 1px solid #e8e6e2; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.07), 0 0 0 1px rgba(0,0,0,0.04);">
            <tr>
              <td style="padding: 32px;">
                <%= yield %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      <tr>
        <td align="center" style="padding: 24px;">
          <p style="margin: 0; font-size: 12px; color: #8a8a94; font-weight: 400;">
            Dotted &mdash; Your digital bujo
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
