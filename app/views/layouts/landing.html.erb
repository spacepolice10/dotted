<!DOCTYPE html>

<html lang="en">
  <head>
    <title><%= content_for(:title) || "Dotted" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="application-name" content="Dotted">
    <meta name="theme-color" content="#f5f5f5">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Geologica:wght@100..900&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%# Keep the landing's shared styles without loading app-only components. %>
    <%= stylesheet_link_tag "_application", "_reset", "base", "card", "empty-state", "pressable", "highlight", "icons", "landing", "typography", "variables" %>
  </head>

  <body class="landing">
    <header class="landing-header">
      <a role="button" data-intent="secondary" data-size="lg" href="<%= landing_path %>">
        <%= image_tag "/icon.svg", class: "landing-logo", alt: "" %>
        Dotted
      </a>

      <div class="landing-menu">
        <input type="checkbox" id="landing-menu-toggle" class="landing-menu-toggle" aria-label="Menu">
        <label for="landing-menu-toggle" class="landing-menu-label button" data-intent="secondary" data-size="lg">
          <%= image_tag "/icon.svg", class: "landing-logo", alt: "" %>
          Dotted
          <%= icon("chevron-down", class: "landing-menu-chevron") %>
        </label>

        <nav aria-label="Product">
          <a role="button" data-intent="secondary" data-size="lg" href="<%= features_path %>">Features</a>
          <a role="button" data-intent="secondary" data-size="lg" href="<%= terminal_path %>">CLI &amp; Agents</a>
          <a role="button" class="landing-sign-in" data-intent="secondary" data-size="lg" href="<%= new_authentication_path %>">Sign in</a>
        </nav>
      </div>
    </header>

    <%= yield %>

    <footer>
      <p>Don’t forget to have fun<span aria-hidden="true">!</span></p>

      <nav aria-label="Footer">
        <a role="button" data-intent="secondary" data-size="lg" href="<%= support_path %>">Support</a>
        <a role="button" data-intent="secondary" data-size="lg" href="<%= once_path %>">
          <%= icon("once", style: "color: oklch(0.55 0.19 258); width: 2.6ch; height: 2.6ch") %> ONCE
        </a>
        <a role="button" data-intent="secondary" data-size="lg" href="https://github.com/spacepolice10/digibujo">
          <%= icon("github") %> GitHub
        </a>
        <a role="button" data-intent="secondary" data-size="lg" href="<%= faqs_path %>">FAQs</a>
      </nav>
    </footer>
  </body>
</html>
