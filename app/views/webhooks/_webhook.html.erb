<%# locals: (webhook:) %>
<article
  id="<%= dom_id(webhook) %>"
  data-elevation="2"
>
  <header>
      <strong><%= webhook.name %></strong>
      <code><%= webhook.code_prefix %>…</code>

  </header>
  <footer>
    <%= button_to webhook_path(webhook),
      method: :delete,
      class: "utilities--mx-auto",
      data: { intent: "secondary", radius: "full", size: "sm", status: "negative" },
      form: { data: { turbo_confirm: "Revoke this webhook? External apps using it will stop working." }, class: "utilities--contents" } do %>
  <%= icon("trash") %>
  Revoke
<% end %>
  </footer>


</article>
