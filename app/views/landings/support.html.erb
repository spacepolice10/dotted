<% content_for(:title) { "Support — Dotted" } %>


<main data-page="support" data-size="sm">
  <header class="landing-heading"><h1>Support</h1></header>

  <article>
    <main>
      <p>
        Questions, bugs, or feedback about Dotted — email the maintainer or open
        an issue on GitHub.
      </p>
      <ul data-layout="column" data-divider="single">
        <li>
          <%= mail_to "naysdemo@zohomail.com" do %>
            <%= icon("mail", style: "color: var(--model-color-2)") %><p>naysdemo@zohomail.com</p>
          <% end %>
        </li>
        <li>
          <%= link_to "https://github.com/spacepolice10/digibujo" do %>
            <%= icon("github", style: "color: var(--model-color-7)") %><p>github.com/spacepolice10/digibujo</p>
          <% end %>
        </li>
      </ul>
    </main>
  </article>
</main>
