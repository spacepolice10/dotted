<% content_for(:title, "Attachments") %>

<%= render "shared/back_tabbar" %>

<main data-size="sm">
  <header>
    <h1>Attachments</h1>

    <p>
      A gallery of your uploaded files.
    </p>
  </header>

  <% if @bullets.any? %>
    <ul class="attachment--gallery">
      <% @bullets.each do |bullet| %>
        <% file = bullet.file %>

        <li class="attachment--tile" id="<%= dom_id(bullet) %>">
          <%= link_to attachment_path(bullet),
                data: { kind: file.variable? ? "picture" : "file", turbo_frame: "_top" },
                aria: { label: "View #{file.filename}" } do %>
            <% if file.variable? %>
              <%= image_tag file.variant(:display),
                    alt: file.filename.to_s,
                    loading: "lazy" %>
            <% else %>
              <span class="attachment--tile-file">
                <%= icon("paperclip") %>
                <span class="attachment--tile-name"><%= file.filename %></span>
                <span class="attachment--tile-size"><%= number_to_human_size(file.byte_size) %></span>
              </span>
            <% end %>
          <% end %>
          <div class="attachment--tile-details">
            <span><%= bullet.pops_on.strftime("%b %-d, %Y") %></span>
            <%= link_to "View bullet", bullet_path(bullet), data: { turbo_frame: "_top" } %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= render "shared/empty_state", icon_name: "paperclip", name: "Nothing attached yet", description: "Files you add to bullets will appear here." %>
  <% end %>
</main>
