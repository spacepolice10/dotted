<% content_for(:title, "Attachments") %>

<%= render "shared/back_tabbar" %>

<main data-size="sm">
  <header>
    <h1>Attachments</h1>

    <p>
      A gallery of your uploaded files.
    </p>
  </header>

  <% if @bullets.any? %>
    <ul class="attachment--gallery">
      <% @bullets.each do |bullet| %>
        <% file = bullet.file %>
        <li class="attachment--tile" id="<%= dom_id(bullet) %>">
          <%= link_to attachment_path(bullet),
                class: "attachment--tile-preview", data: { turbo_frame: "_top" },
                aria: { label: "View #{file.filename}" } do %>
            <% if file.variable? %>
              <%= image_tag file.variant(:display), alt: file.filename.to_s, loading: "lazy" %>
            <% else %>
              <span class="attachment--tile-file">
                <%= icon("paperclip") %>
                <span><%= number_to_human_size(file.byte_size) %></span>
              </span>
            <% end %>
            <span class="pill attachment--preview-name" title="<%= file.filename %>">
              <span class="attachment--preview-filename"><%= file.filename %></span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= render "shared/empty_state", icon_name: "paperclip", name: "Nothing attached yet", description: "Files you add to bullets will appear here." %>
  <% end %>
</main>
