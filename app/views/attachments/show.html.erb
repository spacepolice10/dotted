<% content_for(:title) { @blob.filename.to_s } %>

<%= render "shared/back_tabbar" %>

<main data-size="md">
  <header>
    <div>
      <h1>Attachment</h1>
      <p><%= @blob.filename %></p>
    </div>
  </header>

  <main>
    <% if @blob.representable? %>
      <%= image_tag @blob.representation(resize_to_limit: [1600, 1600]), alt: @blob.filename %>
    <% else %>
      <p>
        <%= link_to @blob.filename,
              rails_blob_path(@blob, disposition: "attachment"),
              data: { turbo: false } %>
        · <%= number_to_human_size @blob.byte_size %>
      </p>
    <% end %>
  </main>
</main>
