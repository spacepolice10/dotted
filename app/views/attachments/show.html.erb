<% content_for(:title) { @blob.filename.to_s } %>

<%= render "shared/back_tabbar" %>

<main data-size="md" class="attachment--detail">
  <header>
    <div>
      <h1>Attachment</h1>
      <p><%= @blob.filename %></p>
    </div>
  </header>

  <div class="attachment--content">
    <% if @blob.representable? %>
      <%= image_tag @blob.representation(resize_to_limit: [1600, 1600]), alt: @blob.filename %>
    <% else %>
      <span class="attachment--preview-icon"><%= icon(attachment_icon(@blob)) %></span>
    <% end %>
    <p><%= number_to_human_size @blob.byte_size %></p>
    <p>
      <%= link_to "Open file", rails_blob_path(@blob, disposition: "inline"),
            target: "_blank", rel: "noopener noreferrer", data: { turbo: false } %>
      ·
      <%= link_to "Download", rails_blob_path(@blob, disposition: "attachment"),
            download: @blob.filename.to_s, data: { turbo: false } %>
    </p>
  </div>
</main>
