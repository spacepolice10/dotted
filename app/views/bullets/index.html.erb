<% content_for(:title, @filter.name) %>

<% if @filter.empty? %>
  <%= render "shared/tabbar" %>
<% else %>
  <%= render "shared/back_tabbar" %>
<% end %>

<main class="timeline--window" data-size="lg">
  <% scroller = capture do %>
    <div
      id="<%= @filter.collection ? dom_id(@filter.collection) : 'timeline' %>"
      class="timeline--scroller"
      data-controller="timeline-scroll"
      data-timeline-scroll-path-value="<%= bullets_path(@filter.to_params) %>"
      data-bullet-menu-target="list"
    >
      <% if @more_bullets %>
        <div
          class="timeline--load-more-trigger"
          data-timeline-scroll-target="trigger"
        >
          <%= icon("spinner", class: "icon icon--spin") %>
          <span class="utilities--sr-only">Loading more bullets</span>
        </div>
      <% end %>

      <%= render "bullets/timeline_sections", bullets: @bullets, timeline: @timeline,
          ensure_current_date: @filter.includes_date?(Date.current) %>

      <% if @bullets.empty? && !@more_bullets %>
        <% if @filter.completed? %>
          <%= render "shared/empty_state", icon_name: "check", name: "A clear page", description: "Completed bullets will appear here." %>
        <% elsif @filter.collection %>
          <%= render "shared/empty_state", icon_name: "folder", name: "Room for ideas", description: "Bullets added to this collection will appear here." %>
        <% else %>
          <%= render "shared/empty_state", icon_name: "pencil", name: "Start anywhere", description: "Write a thought, task, or memory in the composer below." %>
        <% end %>
      <% end %>

    </div>
  <% end %>

  <% if @filter.collection %>
    <%= turbo_frame_tag dom_id(@filter.collection, :timeline), class: "utilities--contents" do %>
      <%= scroller %>
    <% end %>
  <% elsif @filter.completed? %>
    <%= turbo_frame_tag "completed_timeline", class: "utilities--contents" do %>
      <%= scroller %>
    <% end %>
  <% else %>
    <%= scroller %>
  <% end %>

  <br>

  <% if @filter.empty? %>
    <div id="composer_dock" class="composer--dock">
      <%= render "bullets/composer",
          bullet: Bullet.new,
          collection: nil,
          pops_on: Date.current,
          preset: "default",
          autofocus: false %>
    </div>
  <% end %>
</main>
