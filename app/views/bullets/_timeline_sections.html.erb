<%# locals: (bullets:, timeline:, bullet_partial: "bullets/bullet", ensure_current_date: false) %>
<% sections = bullets.group_by { |bullet| timeline.section_of(bullet.pops_on) }.to_a %>

<% if ensure_current_date && sections.none? { |section, _| section.id == "current_date" } %>
  <% first_future = sections.index { |_, section_bullets| section_bullets.first.pops_on > Date.current } %>
  <% sections.insert(first_future || sections.length, [timeline.section_of(Date.current), []]) %>
<% end %>

<% dates_over_page_limit = timeline.filter.single_date? ? [] : timeline.dates_over_page_limit(bullets.map(&:pops_on).uniq) %>

<% sections.each do |section, section_bullets| %>
  <% date = section_bullets.first&.pops_on || Date.current %>
  <div
    id="timeline_section_<%= section.id %>"
    class="timeline--section"
  >
    <div class="timeline--section-header">
      <h2 class="pill"><%= section.name %></h2>
      <% if dates_over_page_limit.include?(date) %>
        <%= link_to "Press to show all the bullets",
              bullets_path(timeline.filter.to_params.merge(from: date.iso8601,
                                                            to: date.iso8601)),
              data: { turbo_frame: "_top", intent: "secondary", size: "sm", radius: "base" } %>
      <% end %>
    </div>

    <% section_bullets.each do |bullet| %>
      <%= render partial: bullet_partial, locals: { bullet: bullet } %>
    <% end %>
  </div>
<% end %>
