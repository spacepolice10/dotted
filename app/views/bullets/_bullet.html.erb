<%# locals: (bullet:) %>
<turbo-frame
  id="<%= dom_id(bullet) %>"
  class="bullet"
  data-bullet-done="<%= bullet.done? ? "true" : "false" %>"
>
  <input
    type="checkbox"
    id="<%= dom_id(bullet, :select_checkbox) %>"
    value="<%= bullet.id %>"
    data-bulk-done="<%= bullet.done? %>"
    data-bulk-published="<%= bullet.published? %>"
    data-public-url="<%= published_url(bullet.public_code) if bullet.published? %>"
    data-note-url="<%= edit_bullet_note_path(bullet) %>"
    data-with-note="<%= bullet.with_note? %>"
    data-bullet-menu-target="checkbox"
    data-action="bullet-menu#toggle"
    class="utilities--sr-only"
  >

  <div class="bullet--content">
    <% if bullet.file.attached? %>
      <label
        class="bullet--select-checkbox"
        for="<%= dom_id(bullet, :select_checkbox) %>"
        aria-label="Select bullet"
      ></label>
    <% end %>
    <div class="bullet--body">
      <% unless bullet.file.attached? %>
        <label
          class="bullet--select-square"
          for="<%= dom_id(bullet, :select_checkbox) %>"
          aria-label="Select bullet"
        ></label>
      <% end %>
      <% if bullet.file.attached? %>
        <%= render "bullets/attachment", file: bullet.file, selection_id: dom_id(bullet, :select_checkbox) %>
      <% else %>
        <%= bullet.body %>
      <% end %>
      <% if bullet.collection.present? || bullet.status.in?(%w[postponed published]) %>
        <div class="bullet--metadata">
          <% if (collection = bullet.collection) %>
            <span class="collection-chip bullet--collection"
                  style="--chip-colour: <%= colour(collection.colour) || 'var(--color-invert-3)' %>;">
              <%= icon("hash") %>
              <span><%= collection.name %></span>
            </span>
          <% end %>
          <% if bullet.status.in?(%w[postponed published]) %>
            <span
              class="collection-chip bullet--status bullet--status--<%= bullet.status %>"
            >
              <%= icon(bullet.marker_icon) %>
              <span>
                <% if bullet.status == "postponed" %>
                  Postponed <%= pluralize(bullet.postponements_number, "time") %>
                <% elsif bullet.status == "published" %>
                  It is published
                <% end %>
              </span>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>
    <% if bullet.with_note? %>
      <%= render "notes/preview", note: bullet.note %>
    <% end %>
  </div>

</turbo-frame>
