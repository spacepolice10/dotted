<%# locals: (bullet:) %>
<turbo-frame
  id="<%= dom_id(bullet) %>"
  class="bullet"
  data-bullet-done="<%= bullet.done? ? "true" : "false" %>"
>
  <input
    type="checkbox"
    id="<%= dom_id(bullet, :select_checkbox) %>"
    value="<%= bullet.id %>"
    data-bulk-done="<%= bullet.done? %>"
    data-bulk-published="<%= bullet.published? %>"
    data-public-url="<%= published_url(bullet.public_code) if bullet.published? %>"
    data-bullet-menu-target="checkbox"
    data-action="bullet-menu#toggle"
    class="utilities--sr-only"
  >

  <div class="bullet--content">
    <% if bullet.file.attached? && bullet.file.variable? %>
      <label
        class="bullet--select-checkbox"
        for="<%= dom_id(bullet, :select_checkbox) %>"
        aria-label="Select bullet"
      ></label>
    <% end %>
    <div class="bullet--body">
      <% unless bullet.file.attached? && bullet.file.variable? %>
        <label
          class="bullet--select-square"
          for="<%= dom_id(bullet, :select_checkbox) %>"
          aria-label="Select bullet"
        ></label>
      <% end %>
      <% if bullet.file.attached? %>
        <% file = bullet.file %>
        <% if file.variable? %>
          <% width, height = file.blob.metadata.values_at("width", "height") %>
          <span class="attachment--preview">
            <%= link_to rails_blob_path(file), class: "attachment--preview-picture",
                    data: { turbo: false }, aria: { label: "Zoom #{file.filename}" } do %>
              <%= image_tag file.variant(:preview),
                    alt: file.filename.to_s,
                    style: (width.present? && height.present? ? "aspect-ratio: #{width} / #{height}" : nil) %>
            <% end %>
            <label class="pill attachment--preview-name" for="<%= dom_id(bullet, :select_checkbox) %>" title="<%= file.filename %>">
              <span class="attachment--preview-filename"><%= file.filename %></span>
            </label>
          </span>
        <% else %>
          <%= link_to rails_blob_path(file, disposition: "attachment"), class: "attachment--file", data: { turbo: false } do %>
            <%= icon("paperclip") %>
            <span class="attachment--file-name utilities--line-clamp-1"><%= file.filename %></span>
            <small><%= number_to_human_size(file.byte_size) %></small>
          <% end %>
        <% end %>
      <% else %>
        <%= bullet.body %>
      <% end %>
    </div>
    <% if bullet.status.present? %>
      <span
        class="bullet--status bullet--status--<%= bullet.status %>"
        style="<%= "color: #{bullet.collection.colour_variable}" if bullet.collection&.colour_variable %>"
      >
        <%= icon(bullet.marker_icon) %>
        <span>
          <% if bullet.status == "postponed" %>
            It was postponed at <%= time_tag bullet.last_postponed_at, bullet.last_postponed_at.strftime("%H:%M on %b %-d, %Y") %>
          <% elsif bullet.status == "published" %>
            It is published
          <% elsif bullet.status == "done" %>
            It is completed
          <% end %>
        </span>
      </span>
    <% end %>
  </div>

</turbo-frame>
