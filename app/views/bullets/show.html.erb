<% content_for(:title, @bullet.name) %>

<%= render "shared/back_tabbar" %>

<main class="bullet-page" data-size="md">
  <% if @bullet.published? %>
    <input <%# herb:disable html-input-require-autocomplete %>
      type="text"
      value="<%= published_url(@bullet.public_code) %>"
      readonly
      onclick="this.select()"
      class="bullet--published-link"
    >
  <% end %>
  <div data-bullet-menu-target="list">
    <%= render "bullets/current_bullet", bullet: @bullet %>
  </div>
  <%= render "bullets/note", bullet: @bullet %>
</main>
