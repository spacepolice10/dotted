<%# locals: (id:, name:, close_on_submit: true, class_name: nil, standalone: false, controllers: nil, actions: nil, size: nil) %>
<%
  name = local_assigns[:name]
  action_list = ["click->dialog#backdropHide"]
  action_list << "turbo:submit-end->dialog#submitSuccess" if close_on_submit
  action_list.concat(Array(actions))
  controller_list = Array(controllers).presence || ("dialog" if standalone)
%>
<dialog
  id="<%= id %>"
  class="dialog<%= " #{class_name}" if class_name.present? %>"
  data-size="<%= size %>"
  closedby="any"
  <% if controller_list.present? %>data-controller="<%= Array(controller_list).join(" ") %>"<% end %>
  data-dialog-target="dialog"
  data-action="<%= action_list.join(" ") %>"
>
  <header>
    <h2> <%= name %></h2>
    <button
      type="button"
      class="dialog--hide button dropdown--element-hide"
      data-intent="primary"
      data-radius="full"
      data-size="xs"
      data-content="icon"
      commandfor="<%= id %>"
      command="close"
      aria-label="Close"
    >
      <%= icon("x") %>
    </button>
  </header>
  <main>
    <%= yield %>
  </main>
</dialog>
