<nav class="tabbar--navigation" aria-label="Primary">
  <% if controller_name == "searches" %>
    <span class="tabbar--item hotkey-hint tabbar--item-active" aria-current="page" aria-label="Search">
      <%= icon("indent-increase", class: "tabbar--item-icon") %>
      <span class="tabbar--item-name">Index</span>
    </span>
  <% else %>
    <%= link_to search_path,
          class: "tabbar--item hotkey-hint",
          aria: { label: "Index" },
          data: {
            controller: "hotkey",
            hotkey: "1",
            action: "keydown.1@document->hotkey#click"
          } do %>
      <%= icon("indent-increase", class: "tabbar--item-icon") %>
      <span class="tabbar--item-name">Index</span>
    <% end %>
  <% end %>

  <% if controller_name == "bullets" %>
    <span class="tabbar--item hotkey-hint tabbar--item-active" aria-current="page" aria-label="Daylog">
      <%= render "shared/tabbar_timeline_mark" %>
      <span class="tabbar--item-name">Daylog</span>
    </span>
  <% else %>
    <%= link_to bullets_path,
          class: "tabbar--item hotkey-hint",
          aria: { label: "Daylog" },
          data: {
            controller: "hotkey",
            hotkey: "2",
            action: "keydown.2@document->hotkey#click"
          } do %>
      <%= render "shared/tabbar_timeline_mark" %>
      <span class="tabbar--item-name">Daylog</span>
    <% end %>
  <% end %>

  <% if controller_name == "users" %>
    <span class="tabbar--item hotkey-hint tabbar--item-active" aria-current="page" aria-label="User">
      <%= icon("face", class: "tabbar--item-icon") %>
      <span class="tabbar--item-name">User</span>
    </span>
  <% else %>
    <%= link_to user_path,
          class: "tabbar--item hotkey-hint",
          aria: { label: "User" },
          data: {
            controller: "hotkey",
            hotkey: "3",
            action: "keydown.3@document->hotkey#click"
          } do %>
      <%= icon("face", class: "tabbar--item-icon") %>
      <span class="tabbar--item-name">User</span>
    <% end %>
  <% end %>
</nav>
