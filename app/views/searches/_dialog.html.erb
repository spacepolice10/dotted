<%# Preloaded search: open with Ctrl/Cmd+K or by typing a letter outside an editor. %>
<button
  type="button"
  class="utilities--sr-only"
  commandfor="search_picker_dialog"
  command="show-modal"
  aria-label="Open search"
  data-controller="hotkey"
  data-action="keydown.meta+k@document->hotkey#click keydown.ctrl+k@document->hotkey#click"
>
  Open search
</button>

<%= render "shared/dialog",
      name: "Search",
      id: "search_picker_dialog",
      standalone: true,
      controllers: ["dialog", "type-to-search"],
      actions: ["keydown@window->type-to-search#open"],
      size: "lg" do %>
  <%= render "searches/picker", search_term: "", entries: Search::Selection.in_menu(Current.user).filter_map(&:searchable) %>
<% end %>
