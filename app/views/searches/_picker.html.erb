<%# locals: (search_term:, entries:) %>

<header>
  <h2 class="utilities--sr-only">Search</h2>
</header>

<main
  data-controller="combobox"
  data-combobox-path-value="<%= search_results_path %>"
>
  <%= form_with url: search_results_path,
        method: :get,
        class: "utilities--contents",
        data: { combobox_target: "searchForm", turbo_frame: "_top" } do %>
    <%= label_tag :search_term, "Search", class: "utilities--sr-only" %>

    <%= search_field_tag :search_term, search_term,
          placeholder: "Type to find a bullet or collection",
          autofocus: !mobile_variant?,
          autocomplete: "off",
          aria: { label: "Search" },
          class: "search--textform",
          data: {
            combobox_target: "textfield",
            type_to_search_target: "textfield",
            action: "input->combobox#search search->combobox#commit keydown->combobox#navigate"
          } %>
  <% end %>

  <div id="search_dialog_results" aria-label="Results">
    <%= render "searches/results", entries: entries, search_term: search_term %>
  </div>
</main>
